{
  "opencollection": "1.0.0",
  "info": {
    "name": "OnPay User API",
    "version": "2.0.0"
  },
  "items": [
    {
      "info": {
        "name": "User",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GET /user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://onpaydev.com/v2/user",
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://app.onpay.com/app/oauth/authorize",
              "accessTokenUrl": "https://app.onpay.com/app/oauth/authorize",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          }
        }
      ]
    }
  ],
  "bundled": true
}